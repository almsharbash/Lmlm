async function ensureProfile(username) {
  const { data: { user } } = await sb.auth.getUser();
  const { error } = await sb.from('profiles').upsert({ id: user.id, username, name: username }, { onConflict: 'id' });
  if (error) throw error;
}

async function enterApp() {
  const { data: { user } } = await sb.auth.getUser();
  if (!user) return showView('loginForm');
  me = user;
  let { data } = await sb.from('profiles').select('*').eq('id', user.id).maybeSingle();
  if (!data) {
    const uname = (user.user_metadata && user.user_metadata.username) || user.email.split('@')[0];
    try { await ensureProfile(uname.toLowerCase()); } catch (e) { toast('تعذّر إنشاء الملف الشخصي'); return; }
    ({ data } = await sb.from('profiles').select('*').eq('id', user.id).maybeSingle());
  }
  profile = data; people[me.id] = profile;
  $('auth').hidden = true; $('app').hidden = false;
  await loadChats();
  subscribe();
}

/* ---------- People & chats ---------- */
async function loadPeople(ids) {
  const need = [...new Set(ids)].filter((id) => id && !people[id]);
  if (!need.length) return;
  const { data } = await sb.from('profiles').select('id, username, name, photo, bio, city, link').in('id', need);
  (data || []).forEach((p) => { people[p.id] = p; });
}

async function loadChats() {
  const { data: mine, error } = await sb.from('chat_members').select('chat_id, chats(id, kind, name, created_at)').eq('user_id', me.id);
  if (error) return toast('تعذّر تحميل المحادثات');
  const rows = (mine || []).filter((r) => r.chats);
  const ids = rows.map((r) => r.chat_id);
  if (!ids.length) { chats = []; return renderList(); }
  const { data: mem } = await sb.from('chat_members').select('chat_id, user_id').in('chat_id', ids);
  await loadPeople((mem || []).map((m) => m.user_id));
  const { data: lastRows } = await sb.from('messages').select('chat_id, body, kind, created_at').in('chat_id', ids).order('created_at', { ascending: false }).limit(500);
  const lastBy = {};
  (lastRows || []).forEach((m) => { if (!lastBy[m.chat_id]) lastBy[m.chat_id] = m; });
  chats = rows.map((r) => {
    const c = r.chats;
    const members = (mem || []).filter((m) => m.chat_id === c.id).map((m) => m.user_id);
    const others = members.filter((id) => id !== me.id).map((id) => people[id]).filter(Boolean);
    const last = lastBy[c.id] || null;
    return {
      id: c.id, kind: c.kind, members,
      title: c.kind === 'group' ? (c.name || 'مجموعة') : (others[0] ? (others[0].name || others[0].username) : 'محادثة'),
      photo: c.kind === 'direct' && others[0] ? others[0].photo : null,
      count: members.length, last, at: last ? last.created_at : c.created_at,
    };
  });
  renderList();
}

function makeRow({ photo, letter, title, sub, time, cls, onClick }) {
  const li = document.createElement('li');
  const b = document.createElement('button');
  b.className = 'item ' + (cls || '');
  const av = document.createElement('div'); av.className = 'avatar';
  setAvatar(av, photo, letter);
  const meta = document.createElement('div'); meta.className = 'meta';
  const t = document.createElement('b'); t.textContent = title;
  const s = document.createElement('span'); s.textContent = sub;
  meta.append(t, s);
  const side = document.createElement('div'); side.className = 'side';
  side.append(span(time || ''));
  b.append(av, meta, side);
  b.addEventListener('click', onClick);
  li.append(b);
  return li;
}

function previewOf(last) {
  if (!last) return null;
  if (last.kind === 'voice') return '🎤 رسالة صوتية';
  if (last.kind === 'image') return '🖼 صورة';
  return last.body || '';
}

function renderList() {
  const ul = $('chats'); ul.innerHTML = '';
  if (profile && profile.id) {
    ul.append(makeRow({ photo: profile.photo, letter: initial(profile), title: profile.name || profile.username,
      sub: '@' + profile.username + ' · الملف الشخصي', cls: 'my-item', onClick: openProfile }));
  }
  const q = $('search').value.trim();
  const list = chats.filter((c) => !q || c.title.includes(q))
    .sort((a, b) => (pins.has(b.id) - pins.has(a.id)) || (a.at < b.at ? 1 : -1));
  list.forEach((c) => ul.append(makeRow({
    photo: c.photo, letter: c.title.charAt(0), title: c.title,
    sub: previewOf(c.last) || (c.kind === 'group' ? c.count + ' أعضاء' : 'ابدأ المحادثة'),
    time: c.last ? timeOf(c.last.created_at) : '',
    cls: (active && c.id === active.id ? 'current ' : '') + (pins.has(c.id) ? 'pinned' : ''),
    onClick: () => openChat(c),
  })));
}
$('search').addEventListener('input', renderList);

async function openChat(c) {
  active = c; selId = null; clearComposer();
  $('app').classList.add('in-chat');
  $('empty').hidden = true; $('chat').classList.add('open');
  $('head').hidden = false; $('msgs').hidden = false; $('form').hidden = false;
  $('title').textContent = c.title;
  $('status').textContent = c.kind === 'group' ? c.count + ' أعضاء' : 'محادثة خاصة';
  setAvatar($('headAvatar'), c.photo, c.title.charAt(0));
  $('pinBtn').style.opacity = pins.has(c.id) ? '1' : '.45';
  await loadMessages();
  renderList();
}

async function loadMessages() {
  if (!active) return;
  const cid = active.id;
  const { data, error } = await sb.from('messages').select('*').eq('chat_id', cid).order('created_at').limit(300);
  if (error) return toast('تعذّر تحميل الرسائل');
  await loadPeople(data.map((m) => m.sender_id));
  if (!active || active.id !== cid) return;
  msgs = data;
  renderMessages();
}

function renderMessages() {
  const box = $('msgs'); box.innerHTML = '';
  msgs.forEach((m) => {
    const mine = m.sender_id === me.id;
    const row = document.createElement('div'); row.className = 'row ' + (mine ? 'me' : 'them');
    const bub = document.createElement('div'); bub.className = 'bubble' + (selId === m.id ? ' sel' : '');
    if (!mine && active && active.kind === 'group') { const f = document.createElement('div'); f.className = 'from'; f.textContent = nameOf(m.sender_id); bub.append(f); }
    if (m.reply_to) {
      const q = msgs.find((x) => x.id === m.reply_to);
      if (q) { const d = document.createElement('div'); d.className = 'quote'; d.textContent = q.body || (q.kind === 'voice' ? 'رسالة صوتية' : 'صورة'); bub.append(d); }
    }
    if (m.kind === 'image' && m.media_url) { const im = document.createElement('img'); im.className = 'img'; im.src = m.media_url; im.alt = ''; bub.append(im); }
    if (m.kind === 'voice' && m.media_url) { const au = document.createElement('audio'); au.controls = true; au.src = m.media_url; bub.append(au); }
    if (m.body) { const t = document.createElement('div'); t.textContent = m.body; bub.append(t); }
    const info = document.createElement('div'); info.className = 'info';
    if (m.edited_at) info.append(span('معدّلة'));
    info.append(span(timeOf(m.created_at)));
    bub.append(info);
    if (selId === m.id) actionsFor(m, bub);
    bub.addEventListener('click', () => { selId = selId === m.id ? null : m.id; renderMessages(); });
    row.append(bub); box.append(row);
  });
  box.scrollTop = box.scrollHeight;
}

function actionsFor(m, bub) {
  const acts = document.createElement('div'); acts.className = 'actions';
  const add = (label, fn) => {
    const b = document.createElement('button'); b.textContent = label;
    b.addEventListener('click', (e) => { e.stopPropagation(); fn(); });
    acts.append(b);
  };
  add('رد', () => { replyTo = m; editing = null; setReply('الرد على', m.body || 'مرفق'); $('input').focus(); });
  if (m.sender_id === me.id) {
    if (m.kind === 'text') add('تعديل', () => { editing = m; replyTo = null; setReply('تعديل الرسالة', m.body); $('input').value = m.body; $('input').focus(); });
    add('حذف', async () => {
      const { error } = await sb.from('messages').delete().eq('id', m.id);
      if (error) return toast('تعذّر الحذف');
      msgs = msgs.filter((x) => x.id !== m.id); selId = null; renderMessages(); loadChats();
    });
  }
  if (m.body) add('نسخ', () => { try { navigator.clipboard.writeText(m.body); } catch (e) {} toast('تم النسخ'); });
  bub.append(acts);
}

function setReply(label, text) {
  if (!label) { $('replyBar').hidden = true; return; }
  $('replyText').textContent = label + ': ' + (text || '');
  $('replyBar').hidden = false;
}
function clearComposer() { $('input').value = ''; editing = null; replyTo = null; setReply(null); }
$('cancelReply').addEventListener('click', clearComposer);
$('back').addEventListener('click', () => { $('chat').classList.remove('open'); $('app').classList.remove('in-chat'); });

async function sendMsg(extra) {
  if (!active) return;
  const cid = active.id;
  const row = { chat_id: cid, kind: 'text', body: null, media_url: null, reply_to: replyTo ? replyTo.id : null, ...extra };
  replyTo = null; setReply(null);
  const { data, error } = await sb.from('messages').insert(row).select().single();
  if (error) return toast('تعذّر الإرسال');
  if (active && active.id === cid && !msgs.find((x) => x.id === data.id)) { msgs.push(data); renderMessages(); }
  loadChats();
}

$('form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = $('input').value.trim();
  if (!active || !text) return;
  if (editing) {
    const when = new Date().toISOString();
    const { error } = await sb.from('messages').update({ body: text, edited_at: when }).eq('id', editing.id);
    if (error) return toast('تعذّر التعديل');
    const m = msgs.find((x) => x.id === editing.id);
    if (m) Object.assign(m, { body: text, edited_at: when });
    clearComposer(); renderMessages();
    return;
  }
  $('input').value = '';
  await sendMsg({ body: text });
});

const EMOJIS = ['😀', '😂', '😍', '👍', '🙏', '🎉', '❤️', '🔥', '😢', '🤔', '👏', '🌹'];
EMOJIS.forEach((em) => {
  const b = document.createElement('button'); b.type = 'button'; b.textContent = em;
  b.addEventListener('click', () => { $('input').value += em; $('input').focus(); });
  $('emojiRow').append(b);
});
$('emojiBtn').addEventListener('click', () => { $('emojiRow').hidden = !$('emojiRow').hidden; });

$('imgFile').addEventListener('change', (e) => {
  const f = e.target.files[0]; e.target.value = '';
  if (!f || !active) return;
  readFile(f, (src) => {
    const im = new Image();
    im.onload = () => {
      const k = Math.min(1, 800 / Math.max(im.width, im.height));
      const c = document.createElement('canvas');
      c.width = Math.round(im.width * k); c.height = Math.round(im.height * k);
      c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
      sendMsg({ kind: 'image', media_url: c.toDataURL('image/jpeg', 0.8) });
    };
    im.src = src;
  });
});

let rec = null, chunks = [], recStart = 0;
$('micBtn').addEventListener('click', async () => {
  if (!active) return;
  if (rec) { rec.stop(); return; }
  if (!navigator.mediaDevices || !window.MediaRecorder) return toast('التسجيل الصوتي غير مدعوم في هذا المتصفح');
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    chunks = []; rec = new MediaRecorder(stream); recStart = Date.now();
    rec.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); };
    rec.onstop = () => {
      stream.getTracks().forEach((t) => t.stop());
      const blob = new Blob(chunks, { type: rec.mimeType || 'audio/webm' });
            rec = null; $('micBtn').classList.remove('rec');
      if (blob.size) readFile(blob, (url) => sendMsg({ kind: 'voice', media_url: url }));
    };
    rec.start(); $('micBtn').classList.add('rec');
    toast('جارٍ التسجيل… اضغط الميكروفون مرة أخرى للإرسال');
  } catch (err) { toast('لم نتمكن من الوصول إلى الميكروفون'); }
});

$('pinBtn').addEventListener('click', () => {
  if (!active) return;
  pins.has(active.id) ? pins.delete(active.id) : pins.add(active.id);
  savePins(); $('pinBtn').style.opacity = pins.has(active.id) ? '1' : '.45';
  renderList(); toast(pins.has(active.id) ? 'تم التثبيت' : 'تم إلغاء التثبيت');
});

function subscribe() {
  if (channel) sb.removeChannel(channel);
  channel = sb.channel('lmlm-msgs').on('postgres_changes', { event: '*', schema: 'public', table: 'messages' }, async (p) => {
    if (p.eventType === 'INSERT') {
      if (active && p.new.chat_id === active.id && !msgs.find((x) => x.id === p.new.id)) {
        await loadPeople([p.new.sender_id]);
        msgs.push(p.new); renderMessages();
      } else if (p.new.sender_id !== me.id) toast('رسالة جديدة');
    } else if (p.eventType === 'UPDATE') {
      const m = msgs.find((x) => x.id === p.new.id);
      if (m) { Object.assign(m, p.new); renderMessages(); }
    } else if (p.eventType === 'DELETE') {
      msgs = msgs.filter((x) => x.id !== (p.old && p.old.id)); if (active) renderMessages();
    }
    loadChats();
  }).subscribe();
}

/* ---------- New chat & groups ---------- */
$('newChatBtn').addEventListener('click', () => { $('ncUser').value = ''; $('newChatSheet').hidden = false; });
$('ncCancel').addEventListener('click', () => { $('newChatSheet').hidden = true; });
$('ncGo').addEventListener('click', async () => {
  const u = $('ncUser').value.trim().toLowerCase();
  if (!u) return;
  const { data: p } = await sb.from('profiles').select('id, username').eq('username', u).maybeSingle();
  if (!p) return toast('لم نجد هذا المستخدم');
  if (p.id === me.id) return toast('لا يمكنك مراسلة نفسك');
  const existing = chats.find((c) => c.kind === 'direct' && c.members.length === 2 && c.members.includes(p.id));
  $('newChatSheet').hidden = true;
  if (existing) return openChat(existing);
  const { data: cid, error } = await sb.rpc('create_chat', { p_kind: 'direct', p_name: null, p_members: [p.id] });
  if (error) return toast('تعذّر فتح المحادثة');
  await loadChats();
  const c = chats.find((x) => x.id === cid);
  if (c) openChat(c);
});

$('newGroupBtn').addEventListener('click', () => { $('gName').value = ''; $('gUsers').value = ''; $('groupSheet').hidden = false; });
$('gCancel').addEventListener('click', () => { $('groupSheet').hidden = true; });
$('gGo').addEventListener('click', async () => {
  const name = $('gName').value.trim();
  const names = $('gUsers').value.split(/[,\s،]+/).map((s) => s.trim().toLowerCase()).filter(Boolean);
  if (!name) return toast('أدخل اسم المجموعة');
  if (!names.length) return toast('أدخل اسم مستخدم عضو واحد على الأقل');
  const { data: ps } = await sb.from('profiles').select('id, username').in('username', names);
  const ids = (ps || []).map((p) => p.id).filter((id) => id !== me.id);
  if (!ids.length) return toast('لم نجد الأعضاء');
  const { data: cid, error } = await sb.rpc('create_chat', { p_kind: 'group', p_name: name, p_members: ids });
  if (error) return toast('تعذّر إنشاء المجموعة');
  $('groupSheet').hidden = true;
  await loadChats();
  const c = chats.find((x) => x.id === cid);
  if (c) openChat(c);
});

/* ---------- Profile ---------- */
function paintPic() { setAvatar($('picImg'), profile.photo, initial(profile)); }
function openProfile() {
  $('pName').value = profile.name || ''; $('pUser').value = profile.username || '';
  $('pBio').value = profile.bio || ''; $('pBirth').value = profile.birth || '';
  $('pCity').value = profile.city || ''; $('pEmail').value = profile.email || '';
  $('pPhone').value = profile.phone || ''; $('pLink').value = profile.link || '';
  $('pPass').value = ''; paintPic();
  $('profile').hidden = false;
}
$('pClose').addEventListener('click', () => { $('profile').hidden = true; });
$('picFile').addEventListener('change', (e) => {
  const f = e.target.files[0]; e.target.value = '';
  if (!f) return;
  readFile(f, (src) => {
    const im = new Image();
    im.onload = async () => {
      const side = Math.min(im.width, im.height);
      const c = document.createElement('canvas'); c.width = c.height = 256;
      c.getContext('2d').drawImage(im, (im.width - side) / 2, (im.height - side) / 2, side, side, 0, 0, 256, 256);
      const photo = c.toDataURL('image/jpeg', 0.85);
      const { error } = await sb.from('profiles').update({ photo }).eq('id', me.id);
      if (error) return toast('تعذّر حفظ الصورة');
      profile.photo = photo; people[me.id] = profile;
      paintPic(); renderList(); toast('تم تحديث الصورة');
    };
    im.src = src;
  });
});
$('pSave').addEventListener('click', async () => {
  const patch = {
    name: $('pName').value.trim(), bio: $('pBio').value.trim(), birth: $('pBirth').value || null,
    city: $('pCity').value.trim(), link: $('pLink').value.trim(),
    email: $('pEmail').value.trim() || null, phone: $('pPhone').value.trim() || null,
  };
  const { error } = await sb.from('profiles').update(patch).eq('id', me.id);
  if (error) return toast('تعذّر الحفظ');
  Object.assign(profile, patch); people[me.id] = profile;
  const np = $('pPass').value;
  if (np) {
    if (np.length < 8) return toast('كلمة المرور 8 أحرف على الأقل');
    const { error: e2 } = await sb.auth.updateUser({ password: np });
    if (e2) return toast('تعذّر تغيير كلمة المرور');
    $('pPass').value = '';
  }
  renderList(); toast('تم الحفظ');
});
$('pLogout').addEventListener('click', async () => { await sb.auth.signOut(); location.reload(); });

/* ---------- Start ---------- */
applyTheme(); syncSettings();
window.__lmlmReady = true;
(async () => {
  const { data: { session } } = await sb.auth.getSession();
  if (session) await enterApp(); else showView('loginForm');
})();
</script>

