  $('auth').hidden = false;
}
document.querySelectorAll('[data-go]').forEach((b) => b.addEventListener('click', () => showView(b.dataset.go)));

$('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = $('lId').value.trim().toLowerCase();
