const saveSt = () => { try { localStorage.setItem('lmlm-settings', JSON.stringify(st)); } catch (e) {} };
const paintVal = () => (st.mode === 'solid' ? st.c1 : `linear-gradient(${st.angle}deg, ${st.c1}, ${st.c2})`);
function applyTheme() {
