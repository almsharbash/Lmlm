$('tBar').addEventListener('change', (e) => change('tBar', e.target.checked));
$('tBtn').addEventListener('change', (e) => change('tBtn', e.target.checked));
$('tBg').addEventListener('change', (e) => change('tBg', e.target.checked));
$('reset').addEventListener('click', () => { st = { ...DEF }; saveSt(); applyTheme(); syncSettings(); toast('تمت إعادة الضبط'); });
