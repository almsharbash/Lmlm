}
function change(k, v) { st[k] = v; saveSt(); applyTheme(); syncSettings(); }
['#7C5CFF', '#1E9BF0', '#0E3A8C', '#00B894', '#FF7A59', '#E84393', '#2D3436'].forEach((c) => {
