<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1E9BF0">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="mobile-web-app-capable" content="yes">
<title>LMLM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
<style>

  :root {
    --sky: #1E9BF0; --deep: #0E3A8C;
    --mist: #EEF5FC; --card: #FFFFFF; --line: #D9E6F4;
    --text: #0E2A5C; --muted: #6A7FA3; --mine-text: #FFFFFF;
  }
  :root[data-theme="dark"] {
    --mist: #0B1B33; --card: #12274B; --line: #1F3B6C;
    --text: #E8F1FF; --muted: #8FA6C9;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --mist: #0B1B33; --card: #12274B; --line: #1F3B6C;
      --text: #E8F1FF; --muted: #8FA6C9;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { height: 100%; margin: 0; overflow: hidden; }
  body {
    font-family: "IBM Plex Sans Arabic", system-ui, sans-serif;
    font-size: 15px; line-height: 1.5; color: var(--text); overflow: hidden;
    background: var(--bg-paint, var(--mist));
  }
  button, input, select { font: inherit; color: inherit; }
  button { cursor: pointer; }
  :focus-visible { outline: 2px solid var(--sky); outline-offset: 2px; }

  .app { height: 100vh; height: 100dvh; width: 100%; max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); overflow: hidden; background: var(--card); }
  .app.in-chat .list { display: none; }
  .chat { min-width: 0; }
  @media (min-width: 760px) { .app { grid-template-columns: 330px minmax(0, 1fr); border-inline: 1px solid var(--line); } .app.in-chat .list { display: flex; } }

  .bar {
    background: var(--bar-paint, var(--card)); color: var(--bar-text, var(--text));
    display: flex; align-items: center; gap: 10px;
    padding: calc(6px + env(safe-area-inset-top, 0px)) 8px 6px;
    border-bottom: 1px solid var(--line); min-height: 52px;
  }
  .icon-btn { width: 36px; height: 36px; border: 0; border-radius: 50%; background: transparent; color: inherit; font-size: 18px; display: grid; place-items: center; flex: none; }
  .icon-btn:hover { background: rgba(127,127,127,.15); }
  .brand { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; }
  .brand img { width: 28px; height: 28px; object-fit: contain; }
  .brand h1 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: 1px; direction: ltr; }

  /* List */
  .list { display: flex; flex-direction: column; min-height: 0; border-inline-end: 1px solid var(--line); }
  .search { margin: 6px 10px; }
  .search input { width: 100%; padding: 6px 12px; font-size: 14px; border-radius: 999px; border: 0; background: var(--mist); outline: none; }
  .chats { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
  .item { display: flex; align-items: center; gap: 10px; padding: 7px 10px; width: 100%; border: 0; background: transparent; text-align: start; position: relative; }
  .item:hover, .item[aria-current="true"] { background: var(--mist); }
  .item.pinned .meta b::after { content: " 📌"; font-size: 12px; }
  .avatar { width: 42px; height: 42px; font-size: 16px; border-radius: 50%; display: grid; place-items: center; flex: none; color: #fff; font-weight: 600; background: var(--av, linear-gradient(135deg,#3CC4FF,#0E3A8C)); position: relative; }
  .avatar.saved { font-size: 22px; }
  .online::after { content: ""; position: absolute; bottom: 1px; inset-inline-end: 1px; width: 11px; height: 11px; border-radius: 50%; background: #34C759; border: 2px solid var(--card); }
  .meta { min-width: 0; flex: 1; }
  .meta b { display: block; font-weight: 600; font-size: 14px; }
  .meta span { display: block; color: var(--muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .side { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; font-size: 11px; color: var(--muted); }
  .badge { background: var(--btn-paint, var(--sky)); color: var(--btn-text, #fff); border-radius: 999px; min-width: 18px; height: 18px; font-size: 11px; padding: 0 6px; display: grid; place-items: center; font-size: 12px; font-weight: 600; }

  /* Chat */
  .chat { display: none; flex-direction: column; min-height: 0; height: 100%; }
  .chat.open { display: flex; }
  @media (min-width: 760px) { .chat { display: flex; } }
  .empty { margin: auto; text-align: center; color: var(--muted); padding: 24px; }
  .empty img { width: 96px; height: 96px; object-fit: contain; margin-bottom: 10px; }
  .empty strong { display: block; color: var(--text); font-size: 22px; font-weight: 600; direction: ltr; }
  .back { display: none; }
  .chat.open .back { display: grid; }
  @media (min-width: 760px) { .back { display: none !important; } }
  .head-meta { flex: 1; min-width: 0; }
  .head-meta b { display: block; font-size: 15px; }
  .head-meta span { display: block; font-size: 12px; color: var(--muted); }
  .bar .head-meta span { color: inherit; opacity: .75; }
  .menu { position: absolute; top: 40px; inset-inline-end: 0; background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.15); z-index: 5; min-width: 170px; overflow: hidden; }
  .menu[hidden] { display: none; }
  .menu button { display: block; width: 100%; padding: 9px 12px; font-size: 14px; border: 0; background: transparent; text-align: start; }
  .menu button:hover { background: var(--mist); }
  .wrap { position: relative; }

  .msgs { flex: 1; overflow-y: auto; padding: 10px 10px 4px; display: flex; flex-direction: column; gap: 4px; background: var(--chat-paint, transparent); }
  .day { align-self: center; background: var(--card); color: var(--muted); font-size: 12px; padding: 2px 12px; border-radius: 999px; margin: 6px 0; opacity: .9; }
  .row { display: flex; }
  .row.me { justify-content: flex-start; }
  .row.them { justify-content: flex-end; }
  .bubble { max-width: 82%; padding: 6px 10px 4px; font-size: 14px; border-radius: 16px; background: var(--card); border: 1px solid var(--line); word-wrap: break-word; white-space: pre-wrap; cursor: pointer; position: relative; }
  .me .bubble { background: var(--btn-paint, var(--sky)); color: var(--btn-text, var(--mine-text)); border-color: transparent; border-end-start-radius: 4px; }
  .them .bubble { border-end-end-radius: 4px; }
  .bubble.sel { outline: 2px solid var(--sky); outline-offset: 1px; }
  .quote { border-inline-start: 3px solid currentColor; padding: 2px 8px; margin-bottom: 4px; border-radius: 6px; background: rgba(127,127,127,.12); font-size: 13px; opacity: .9; }
  .info { display: flex; gap: 6px; justify-content: flex-end; align-items: center; font-size: 11px; opacity: .7; margin-top: 2px; direction: ltr; }
  .tick.read { color: #7FE3FF; }
  .img { max-width: 240px; width: 100%; border-radius: 10px; display: block; margin-bottom: 4px; }
  .file { font-size: 14px; text-decoration: underline; }
  .actions { display: none; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
  .bubble.sel .actions { display: flex; }
  .actions button { border: 0; border-radius: 999px; padding: 4px 10px; font-size: 13px; background: rgba(127,127,127,.18); color: inherit; }
  .typing { color: var(--muted); font-size: 14px; padding: 0 16px 4px; min-height: 24px; }

  .reply-bar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-top: 1px solid var(--line); background: var(--card); font-size: 14px; }
  .reply-bar div { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); }
  .reply-bar b { color: var(--sky); display: block; }
  .emoji-row { display: flex; gap: 6px; padding: 6px 12px; overflow-x: auto; border-top: 1px solid var(--line); background: var(--card); }
  .emoji-row button { border: 0; background: transparent; font-size: 22px; padding: 2px; }
  .composer { display: flex; align-items: center; gap: 4px; padding: 6px 8px calc(8px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); background: var(--card); }
  .composer input[type="text"] { flex: 1; min-width: 0; padding: 8px 12px; font-size: 14px; border-radius: 999px; border: 0; background: var(--mist); outline: none; }
  .send { width: 38px; height: 38px; border: 0; border-radius: 50%; flex: none; background: var(--btn-paint, var(--sky)); color: var(--btn-text, #fff); font-size: 18px; display: grid; place-items: center; }
  .send.fly { animation: fly .6s ease-out; }
  @keyframes fly { 0% { transform: none; } 40% { transform: translate(-3px,-5px) rotate(-14deg); } 100% { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .send.fly { animation: none; } }
  .file-input { display: none; }
  .pick-wrap { position: relative; overflow: hidden; display: inline-grid; place-items: center; }
  .pick-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; font-size: 0; }
  .from { font-size: 12px; font-weight: 600; color: var(--sky); margin-bottom: 2px; }
  .me .from { color: inherit; }
  .icon-btn.rec { color: #E84343; }
  audio { max-width: 230px; display: block; margin-bottom: 4px; }

  /* Settings sheet */
  .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; justify-content: center; z-index: 20; }
  .overlay[hidden] { display: none; }
  .sheet { background: var(--card); color: var(--text); width: 100%; max-width: 520px; max-height: 88vh; overflow-y: auto; border-radius: 18px 18px 0 0; padding: 14px 18px calc(18px + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 760px) { .overlay { align-items: center; } .sheet { border-radius: 18px; } }
  .sheet h2 { margin: 0 0 10px; font-size: 18px; }
  .sheet h3 { font-size: 14px; color: var(--muted); font-weight: 500; margin: 16px 0 8px; }
  .row2 { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 8px 0; }
  .row2 select, .row2 input[type="text"] { padding: 6px 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--mist); }
  .swatches { display: flex; gap: 8px; flex-wrap: wrap; }
  .swatch { width: 38px; height: 38px; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 0 1px var(--line); }
  .swatch[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--sky); }
  .preview { height: 70px; border-radius: 14px; border: 1px solid var(--line); margin: 10px 0; }
  .targets label { display: flex; align-items: center; gap: 8px; margin: 6px 0; }
  .done { width: 100%; margin-top: 12px; padding: 11px; border-radius: 12px; border: 0; background: var(--sky); color: #fff; font-weight: 600; }
  .ghost { border: 1px solid var(--line); background: transparent; border-radius: 10px; padding: 6px 12px; }
  .toast { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); background: var(--text); color: var(--card); padding: 8px 14px; border-radius: 999px; font-size: 14px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 30; }
  .toast.show { opacity: .95; }

  .auth { position: fixed; inset: 0; z-index: 40; background: var(--mist); display: flex; align-items: center; justify-content: center; padding: 16px; overflow-y: auto; }
  .auth-card { background: var(--card); width: 100%; max-width: 380px; border-radius: 18px; padding: 18px; display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--line); }
  .auth-card h2 { margin: 0; text-align: center; font-size: 18px; }
  .auth-card input { padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--mist); font-size: 15px; }
  .auth-card code { direction: ltr; display: block; background: var(--mist); padding: 10px; border-radius: 10px; font-size: 18px; text-align: center; word-break: break-all; }
  .tabs { display: flex; gap: 6px; }
  .tabs button { flex: 1; padding: 7px 4px; border-radius: 10px; border: 1px solid var(--line); background: transparent; font-size: 13px; }
  .tabs button[aria-pressed="true"] { background: var(--sky); color: #fff; border-color: transparent; }
  .hint { color: var(--muted); font-size: 13px; margin: 0; }
  .link { border: 0; background: transparent; color: var(--sky); }
  .check { display: flex; gap: 8px; align-items: center; font-size: 14px; }
  .done[disabled] { opacity: .5; }
  .field { display: flex; flex-direction: column; gap: 4px; margin: 8px 0; font-size: 14px; }
  .field input, .field textarea { padding: 8px 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--mist); font: inherit; }
  .pic { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .pic-img { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg,#3CC4FF,#0E3A8C) center/cover no-repeat; color: #fff; display: grid; place-items: center; font-size: 26px; font-weight: 600; flex: none; }
  .ghost-btn { display: inline-block; border: 1px solid var(--line); background: transparent; border-radius: 10px; padding: 6px 12px; cursor: pointer; }

  .item.current { background: var(--mist); }
  .from { font-size: 12px; font-weight: 600; color: var(--sky); margin-bottom: 2px; }
  .me .from { color: inherit; }
  .quote { font-size: 13px; opacity: .85; border-inline-start: 3px solid currentColor; padding: 2px 8px; margin-bottom: 4px; }
  .composer input[type="text"] { font-size: 14px; }
  .empty img { width: 96px; height: 96px; object-fit: contain; }
</style>
</head>
<body>

<div class="auth" id="auth" hidden>
  <form class="auth-card" id="loginForm" hidden>
    <h2>تسجيل الدخول</h2>
    <input id="lId" placeholder="اسم المستخدم أو البريد الإلكتروني" autocomplete="username">
    <input id="lPass" type="password" placeholder="كلمة المرور" autocomplete="current-password">
    <button class="done" type="submit">دخول</button>
    <button type="button" class="link" data-go="chooseForm">إنشاء حساب جديد</button>
  </form>

  <div class="auth-card" id="chooseForm" hidden>
    <h2>إنشاء حساب</h2>
    <button type="button" class="done" data-go="rimForm">بدون بريد (كلمة مرور تلقائية)</button>
    <button type="button" class="done" data-go="regForm">بالبريد الإلكتروني (رمز تحقق)</button>
    <button type="button" class="link" data-go="loginForm">لدي حساب بالفعل</button>
  </div>

  <form class="auth-card" id="rimForm" hidden>
    <h2>حساب بدون بريد</h2>
    <p class="hint">ستُولَّد لك كلمة مرور تبدأ بـ rim وتظهر مرة واحدة فقط. لا توجد وسيلة لاستعادتها إن نسيتها.</p>
    <input id="rimUser" placeholder="اسم المستخدم (إنجليزي أو أرقام)" maxlength="20" autocomplete="username">
    <button class="done" type="submit">إنشاء الحساب</button>
    <button type="button" class="link" data-go="chooseForm">رجوع</button>
  </form>

  <form class="auth-card" id="regForm" hidden>
    <h2>حساب بالبريد الإلكتروني</h2>
    <input id="rUser" placeholder="اسم المستخدم (إنجليزي أو أرقام)" maxlength="20" autocomplete="username">
    <input id="rEmail" type="email" placeholder="البريد الإلكتروني" autocomplete="email">
    <input id="rPass" type="password" placeholder="كلمة المرور (8 أحرف على الأقل)" autocomplete="new-password">
    <button class="done" type="submit">إرسال رمز التحقق</button>
    <button type="button" class="link" data-go="chooseForm">رجوع</button>
  </form>

  <div class="auth-card" id="verifyBox" hidden>
    <h2>أدخل رمز التحقق</h2>
    <p class="hint">أرسلنا رمزاً من 6 أرقام إلى <span id="vTo"></span></p>
    <input id="vCode" inputmode="numeric" maxlength="6" placeholder="000000">
    <button class="done" id="verifyBtn">تأكيد</button>
    <button type="button" class="ghost-btn" id="resendBtn">إعادة الإرسال</button>
  </div>

  <div class="auth-card" id="genBox" hidden>
    <h2>كلمة المرور الخاصة بك</h2>
    <p class="hint">احفظها الآن. لن تُعرض مرة أخرى.</p>
    <code id="genPass"></code>
    <button type="button" class="ghost-btn" id="genCopy">نسخ</button>
    <label class="check"><input type="checkbox" id="genSaved"> حفظتها في مكان آمن</label>
    <button class="done" id="genDone" disabled>متابعة</button>
  </div>
</div>

<div class="app" id="app" hidden>
  <aside class="list" aria-label="المحادثات">
    <div class="bar">
      <button class="icon-btn" id="openSettings" aria-label="الإعدادات">☰</button>
      <div class="brand"><img src="data:image/png;base64," alt=""><h1>LMLM</h1></div>
      <button class="icon-btn" id="newChatBtn" aria-label="محادثة جديدة">✎</button>
      <button class="icon-btn" id="newGroupBtn" aria-label="مجموعة جديدة">👥</button>
    </div>
    <div class="search"><input id="search" type="search" placeholder="بحث" aria-label="بحث"></div>
    <ul class="chats" id="chats"></ul>
  </aside>

  <section class="chat" id="chat">
    <div class="empty" id="empty">
      <img src="data:image/png;base64," alt="">
      <strong>LMLM</strong>
      <p>اختر محادثة للبدء</p>
    </div>
    <header class="bar" id="head" hidden>
      <button class="icon-btn back" id="back" aria-label="رجوع">›</button>
      <div class="avatar" id="headAvatar"></div>
      <div class="head-meta"><b id="title"></b><span id="status"></span></div>
      <button class="icon-btn" id="pinBtn" aria-label="تثبيت المحادثة">📌</button>
    </header>
    <div class="msgs" id="msgs" hidden></div>
    <div class="reply-bar" id="replyBar" hidden>
      <div id="replyText"></div>
      <button class="icon-btn" id="cancelReply" aria-label="إلغاء">✕</button>
    </div>
    <div class="emoji-row" id="emojiRow" hidden></div>
    <form class="composer" id="form" hidden>
      <button type="button" class="icon-btn" id="emojiBtn" aria-label="إيموجي">☺</button>
      <label class="icon-btn pick-wrap" aria-label="إرسال صورة">🖼<input type="file" id="imgFile" accept="image/*" class="pick-input"></label>
      <button type="button" class="icon-btn" id="micBtn" aria-label="رسالة صوتية">🎙</button>
      <input id="input" type="text" placeholder="اكتب رسالة" autocomplete="off" maxlength="2000" aria-label="نص الرسالة">
      <button class="send" type="submit" aria-label="إرسال">➤</button>
    </form>
  </section>
</div>

<div class="overlay" id="newChatSheet" hidden>
  <div class="sheet">
    <h2>محادثة جديدة</h2>
    <div class="field"><label for="ncUser">اسم مستخدم الشخص</label><input id="ncUser" maxlength="20"></div>
    <button class="done" id="ncGo">فتح المحادثة</button>
    <button class="ghost" id="ncCancel" style="width:100%;margin-top:8px">إلغاء</button>
  </div>
</div>

<div class="overlay" id="groupSheet" hidden>
  <div class="sheet">
    <h2>مجموعة جديدة</h2>
    <div class="field"><label for="gName">اسم المجموعة</label><input id="gName" maxlength="40"></div>
    <div class="field"><label for="gUsers">أسماء مستخدمي الأعضاء (مفصولة بفاصلة)</label><input id="gUsers"></div>
    <button class="done" id="gGo">إنشاء المجموعة</button>
    <button class="ghost" id="gCancel" style="width:100%;margin-top:8px">إلغاء</button>
  </div>
</div>

<div class="overlay" id="profile" hidden>
  <div class="sheet" role="dialog" aria-modal="true">
    <h2>الملف الشخصي</h2>
    <div class="pic">
      <div class="pic-img" id="picImg"></div>
      <label class="ghost-btn pick-wrap">تغيير الصورة<input type="file" id="picFile" accept="image/*" class="pick-input"></label>
    </div>
    <div class="field"><label for="pName">الاسم</label><input id="pName" maxlength="40"></div>
    <div class="field"><label for="pUser">اسم المستخدم (ثابت لتسجيل الدخول)</label><input id="pUser" readonly></div>
    <div class="field"><label for="pBio">النبذة أو العنوان</label><textarea id="pBio" maxlength="160" rows="2"></textarea></div>
    <div class="field"><label for="pBirth">تاريخ الميلاد</label><input type="date" id="pBirth"></div>
    <div class="field"><label for="pCity">المدينة</label><input id="pCity" maxlength="40"></div>
    <div class="field"><label for="pEmail">البريد الإلكتروني</label><input id="pEmail" type="email"></div>
    <div class="field"><label for="pPhone">رقم الهاتف</label><input id="pPhone" type="tel"></div>
    <div class="field"><label for="pLink">رابط</label><input id="pLink" type="url"></div>
    <div class="field"><label for="pPass">كلمة مرور جديدة (اختياري)</label><input id="pPass" type="password" autocomplete="new-password"></div>
    <button class="done" id="pSave">حفظ التغييرات</button>
    <button class="ghost" id="pLogout" style="width:100%;margin-top:8px">تسجيل الخروج</button>
    <button class="ghost" id="pClose" style="width:100%;margin-top:8px">إغلاق</button>
  </div>
</div>

<div class="overlay" id="settings" hidden>
  <div class="sheet" role="dialog" aria-modal="true">
    <h2>الإعدادات</h2>
