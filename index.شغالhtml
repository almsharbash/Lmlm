const rnd = (n) => { const a = new Uint32Array(n); crypto.getRandomValues(a); return Array.from(a, (x) => ALPH[x % ALPH.length]).join(''); };
const timeOf = (iso) => new Date(iso).toLocaleTimeString('ar', { hour: '2-digit', minute: '2-digit' });
const initial = (p) => ((p && (p.name || p.username)) || '?').charAt(0);
